# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─── EMAIL (Web3Forms) ────────────────────────────────────────────────────────
# WEB3FORMS_ACCESS_KEY: Free API key from https://web3forms.com
# Sign up → Create a form → Copy the Access Key → paste it below.
# Then add it to Vercel: Project Settings → Environment Variables → WEB3FORMS_ACCESS_KEY
# IMPORTANT: This key is SERVER-SIDE only (Vercel Function). Never expose it in client JS.
WEB3FORMS_ACCESS_KEY="YOUR_WEB3FORMS_ACCESS_KEY_HERE"
